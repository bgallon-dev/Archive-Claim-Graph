# Copy this file to `.env` and fill in your local values.
# Never commit the real `.env` file.

# Required for Neo4j backend (`graphrag load-graph --backend neo4j`)
# Local/self-signed example:
NEO4J_URI=bolt+ssc://your-host:7687
# Aura/public CA example:
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# Production: connect via bolt://localhost:7687 when Neo4j is on the app
# server, bolt+s:// when on a different host within the trusted network.
# Drop inbound 7687/7474 at the OS firewall except from the app server.

# Application Neo4j user — should be a least-privilege account with read/
# write on the relevant databases only. Reserve the `neo4j` admin account
# for ops tasks (DDL migrations, user management, backups).
NEO4J_USER=gemynd_app
# In production, source NEO4J_PASSWORD via the institution's secret store
# (Vault, Windows Credential Manager, etc.) — never commit it here.
NEO4J_PASSWORD=your-password-here

# Optional (defaults to neo4j)
NEO4J_DATABASE=neo4j

# Optional trust settings when using bolt:// or neo4j://
# Values: system | all | custom
NEO4J_TRUST=system
# Required only when NEO4J_TRUST=custom
NEO4J_CA_CERT=

# Optional metadata defaults for extraction runs
OCR_ENGINE=tesseract
OCR_VERSION=5.x

# ---------------------------------------------------------------------------
# Claim-extraction LLM provider (EXTRACTION PATH ONLY)
# ---------------------------------------------------------------------------
# anthropic       -> Anthropic Claude (default; requires ANTHROPIC_API_KEY)
# openai|lmstudio -> any OpenAI-compatible /v1 server, e.g. LM Studio (local)
# Local models require:  pip install 'gemynd[local]'
LLM_PROVIDER=anthropic
# Model id for the extraction provider (LM Studio: the loaded model's id from
# GET /v1/models). Ignored by the Anthropic path (use CLAIM_EXTRACTION_MODEL there).
LLM_MODEL=
# OpenAI-compatible server base URL (used only when LLM_PROVIDER=openai|lmstudio)
OPENAI_BASE_URL=http://localhost:1234/v1
# LM Studio ignores the key, but the SDK needs a non-empty string.
OPENAI_API_KEY=lm-studio
# Local models are free: claim-cache hits are NOT recorded to token_usage.db.

# Synthesis model (Anthropic). Override to switch models without a code deployment.
# Defaults to claude-sonnet-4-6 if unset.
SYNTHESIS_MODEL=claude-sonnet-4-6
# Optional local synthesis through LM Studio. The local path uses constrained
# JSON, disables reasoning, and caps evidence/output for predictable latency.
# SYNTHESIS_PROVIDER=lmstudio
# SYNTHESIS_OPENAI_MODEL=google/gemma-4-e4b
# SYNTHESIS_OPENAI_API_KEY=your-lm-studio-token
SYNTHESIS_LOCAL_CLAIM_BUDGET=30
SYNTHESIS_LOCAL_MAX_TOKENS=1200

# ---------------------------------------------------------------------------
# OpenCode synthesis (optional alternative to Anthropic)
# ---------------------------------------------------------------------------
# SYNTHESIS_PROVIDER=opencode
# SYNTHESIS_OPENCODE_MODE=server                  # server | cli
# SYNTHESIS_OPENCODE_URL=http://127.0.0.1:4096    # `opencode serve` endpoint (server mode)
# SYNTHESIS_OPENCODE_USERNAME=opencode            # basic-auth username (server mode)
# SYNTHESIS_OPENCODE_PASSWORD=                    # basic-auth password (server mode)
# SYNTHESIS_OPENCODE_MODEL=                       # e.g. anthropic/claude-sonnet-4-6; empty = opencode default
# SYNTHESIS_OPENCODE_AGENT=synthesis              # shipped .opencode/agent/synthesis.md (no tools)
# SYNTHESIS_OPENCODE_BINARY=opencode              # path to `opencode` binary (cli mode)
# SYNTHESIS_OPENCODE_DIR=                         # working directory for the opencode subprocess (cli mode)

# Required for synthesis (Anthropic Claude API)
# Both names are accepted; ANTHROPIC_API_KEY is the standard form.
ANTHROPIC_API_KEY=sk-ant-...
# Legacy alias (also accepted):
# Anthropic_API_Key=sk-ant-...

# Context ordering: auto | proximity | kgr | confidence.
# auto uses graph proximity and adds KGR for anchored temporal queries when
# KGR_ROOT points at a kettle-graph-reasoner checkout.
CONTEXT_RANKER=auto
KGR_ROOT=C:/path/to/kettle-graph-reasoner
# KGR requires this in the process environment before Python starts. Setting
# it only through a late dotenv load is insufficient; launch the server with
# PYTHONHASHSEED=0 (the museum demo launcher exports it automatically).

# API bearer-token authentication for the query server (graphrag query-serve)
# JSON object mapping token strings to {"role": ..., "institution_id": ...}
# Roles: public | staff | restricted | indigenous_admin | admin
# If unset, server falls back to anonymous public-only access (development mode).
GRAPHRAG_API_TOKENS={"tok_example_staff": {"role": "staff", "institution_id": "turnbull"}, "tok_example_admin": {"role": "admin", "institution_id": "turnbull"}}

# Paths to SQLite log databases (created automatically on first use)
# Conversation query log
CONV_LOG_DB=data/conversation_log.db
# Write-operation audit log (ingestion, soft-deletion, restoration)
WRITE_AUDIT_DB=data/write_audit.db

# ---------------------------------------------------------------------------
# Auth + security
# ---------------------------------------------------------------------------
# JWT signing key — required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# CSRF middleware HMAC secret — required for browser-driven POST/DELETE.
# If unset the app falls back to JWT_SECRET_KEY; set this separately so
# the two can be rotated independently in production.
CSRF_SECRET_KEY=

# Cookie security: secure-by-default. Set to "false" only for local dev
# over plain HTTP — production must keep this true.
COOKIE_SECURE=true

# JWT lifetime in hours (default 24).
JWT_EXPIRE_HOURS=24

# Setup-token file path (mode 0600). Persisted across uvicorn workers so
# only one banner is printed and workers cannot disagree about the token.
SETUP_TOKEN_PATH=data/setup-token

# Trusted reverse proxies — comma-separated list of IPs allowed to set
# X-Forwarded-For. Empty (default) = trust no proxy. At EWU this must be
# set to the institutional proxy's IP, otherwise the rate limiter sees
# only the proxy and collapses every user into one bucket.
TRUSTED_PROXY_IPS=

# Login rate limits: dual-bucket (per-IP outer, per-(IP,email) inner).
# Inner bucket protects individual accounts from credential stuffing
# without locking out a NAT'd network (dorm/lab) when one user has trouble.
LOGIN_RATE_LIMIT_IP_MAX=50
LOGIN_RATE_LIMIT_IP_PERIOD=300
LOGIN_RATE_LIMIT_ACCOUNT_MAX=5
LOGIN_RATE_LIMIT_ACCOUNT_PERIOD=300

# /auth/setup rate limits — same dual-bucket pattern, applied to the
# unauthenticated first-run setup endpoint.
SETUP_RATE_LIMIT_IP_MAX=50
SETUP_RATE_LIMIT_IP_PERIOD=300
SETUP_RATE_LIMIT_MAX=5
SETUP_RATE_LIMIT_PERIOD=300

# /v1/query rate limit (per-user; admins exempt).
QUERY_RATE_LIMIT_MAX=20
QUERY_RATE_LIMIT_PERIOD=60
# Separate, stricter budget for synchronous evidence-gap investigations.
DEEP_RESEARCH_RATE_LIMIT_MAX=4
DEEP_RESEARCH_RATE_LIMIT_PERIOD=60
