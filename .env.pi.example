# Pi 5 Neo4j credentials used only by demo-pi.cmd.
#
# Copy this file to .env.pi and replace the password. The launcher supplies
# bolt://pi5node1.local:7687 and database=newspapers separately so this file
# contains authentication only.
#
# Use a read-only Neo4j account for demos. Do not put SSH credentials here.
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-pi-neo4j-password
