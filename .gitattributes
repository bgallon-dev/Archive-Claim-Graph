# Files that are executed on the deployment host must keep LF endings even
# when checked out on Windows. A CRLF shebang ("#!/usr/bin/env bash\r") fails
# on Linux with "bad interpreter: No such file or directory" — which reads as
# a missing bash, not a line-ending problem, and costs an hour to diagnose.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf

# Vendored front-end assets: leave byte-identical to what was downloaded.
gemynd/shared_static/** -text
*.woff2         binary
*.min.js        -text
