[Unit]
Description=Kettle evidence MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gemynd
Group=gemynd
WorkingDirectory=/opt/gemynd
EnvironmentFile=/etc/gemynd/kettle.env
Environment=KETTLE_MCP_SNAPSHOT_PATH=/opt/gemynd/snapshots/current
Environment=KETTLE_MCP_REGISTRY_PATH=/opt/gemynd/deploy/kettle-corpus-registry.yaml
Environment=KETTLE_MCP_HOST=127.0.0.1
Environment=KETTLE_MCP_PORT=8789
ExecStart=/opt/gemynd/.venv/bin/gemynd-mcp
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gemynd/data
ReadOnlyPaths=/opt/gemynd/snapshots
LimitNOFILE=8192
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gemynd-mcp
UMask=0077

[Install]
WantedBy=multi-user.target
