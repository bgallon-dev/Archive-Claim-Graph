# Copy to /etc/gemynd/kettle.env, replace values, and chmod 600.
# Never put the populated file in the application checkout.
KETTLE_MCP_API_KEYS=old-rotation-key,new-rotation-key
# Authenticated tenant identity is derived from the API key. Client-supplied
# X-Kettle-Tenant headers are intentionally ignored when keys are configured.
KETTLE_MCP_REQUIRE_PAYMENT=true
KETTLE_PAYMENT_VERIFIER_URL=https://payments.internal.example/verify
KETTLE_PAYMENT_VERIFIER_TOKEN=replace-with-verifier-service-token
KETTLE_PAYMENT_LEDGER=/opt/gemynd/data/kettle_payments.db
KETTLE_MCP_RATE_LIMIT=120
KETTLE_MCP_RATE_WINDOW=60
KETTLE_MCP_DAILY_CAP_USD=5.0
KETTLE_MCP_LOG_LEVEL=INFO

# Coinbase CDP facilitator / x402. Start on Base Sepolia and change to
# eip155:8453 only after an explicit mainnet launch review.
KETTLE_X402_ENABLED=false
KETTLE_X402_NETWORK=eip155:84532
KETTLE_X402_PAY_TO=replace-with-nonzero-receiving-address
KETTLE_X402_PUBLIC_BASE_URL=https://research.example.com
CDP_API_KEY_ID=replace-with-cdp-api-key-id
CDP_API_KEY_SECRET=replace-with-cdp-api-key-secret

# Wallet seed phrases and private keys deliberately have no supported setting.
# They belong only in the isolated payment verifier/signing service.
